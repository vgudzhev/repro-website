---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Open format for reproducible AI agent failures." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <nav class="nav" role="navigation" aria-label="Main">
      <a href="/" class="nav-logo">repro<span class="dim">.md</span></a>
      <ul class="nav-links">
        <li><a href="/docs/">Docs</a></li>
        <li><a href="https://github.com/vgudzhev/repro">GitHub</a></li>
        <li><span class="nav-version">v0.1</span></li>
        <li><button class="theme-toggle" aria-label="Toggle theme" type="button"></button></li>
      </ul>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <div class="footer-inner">
          <div>
            <div class="footer-logo">repro<span class="dim">.md</span></div>
            <div class="footer-tagline">Open format for reproducible AI agent failures.</div>
          </div>
          <ul class="footer-links">
            <li><a href="/docs/">Docs</a></li>
            <li><a href="https://github.com/vgudzhev/repro">GitHub</a></li>
            <li><a href="/spec/">Specification</a></li>
            <li><span style="font-size:0.8125rem;color:var(--color-fg-dim)">v0.1</span></li>
          </ul>
        </div>
      </div>
    </footer>
    <script>
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target');
          if (!target) return;
          const el = document.getElementById(target);
          if (!el) return;
          navigator.clipboard.writeText(el.textContent || '').then(() => {
            const prev = btn.textContent;
            btn.textContent = 'copied';
            setTimeout(() => { btn.textContent = prev; }, 1500);
          });
        });
      });

      const sun = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`;
      const moon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`;

      function isDark() {
        const t = document.documentElement.getAttribute('data-theme');
        if (t) return t === 'dark';
        return window.matchMedia('(prefers-color-scheme: dark)').matches;
      }

      function updateToggle() {
        const btn = document.querySelector('.theme-toggle');
        if (btn) btn.innerHTML = isDark() ? sun : moon;
      }

      updateToggle();

      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateToggle();
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
